                            brief: '公众场合的自信表达',
                            description: '克服演讲恐惧，掌握公众演讲的基本技巧和方法。',
                            estimatedTime: 40,
                            learnerCount: 289,
                            status: 'new',
                            tags: ['演讲', '公众']
                        },
                        {
                            id: 21,
