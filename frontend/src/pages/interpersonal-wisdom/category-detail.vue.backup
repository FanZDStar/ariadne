                            estimatedTime: 20,
                            learnerCount: 956,
                            status: 'learning',
                            tags: ['情感', '表达'],
                            progress: 65
                        },
                        {
                            id: 3,
                            name: '非暴力沟通',
                            brief: '以善意和理解进行沟通',
                            description: '学习非暴力沟通的四个步骤：观察、感受、需要、请求。',
                            estimatedTime: 30,
                            learnerCount: 567,
                            status: 'new',
                            tags: ['沟通技巧', '冲突处理']
                        },
                        {
                            id: 13,
