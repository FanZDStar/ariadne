                            estimatedTime: 28,
                            learnerCount: 234,
                            status: 'new',
                            tags: ['残障', '包容']
                        }
                    ],
                    learningTips: [
                        {
                            title: '特殊情境应对策略',
                            content: '每种情境都有其特殊性，重要的是保持灵活性和适应性，必要时寻求专业帮助。'
